# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored -- never commit real values.
# ---------------------------------------------------------------------------

# RPC endpoints. HTTP for discovery/reads, WS for Phase 2 event subscriptions.
# Get a keyed endpoint (Alchemy/QuickNode) for production: the public HTTP
# endpoint rate-limits hard, and wss://mainnet.base.org does not serve WS.
BASE_RPC_HTTP=https://mainnet.base.org
BASE_RPC_WS=wss://base-rpc.publicnode.com
CHAIN_ID=8453

# --- discovery thresholds --------------------------------------------------
MIN_POOL_LIQUIDITY_USD=150000
MIN_TOKEN_LIQUIDITY_USD=500000
MIN_DEX_COUNT=2
DISCOVERY_PAGES_PER_REFRESH=10
DISCOVERY_PAGE_SIZE=20
DISCOVERY_REFRESH_MS=300000
WATCHLIST_PATH=state/watchlist.json

# --- safety -------------------------------------------------------------
# DRY_RUN defaults to true. Only the exact string "false" enables live sends.
DRY_RUN=true
MAX_GAS_PRICE_GWEI=50
MAX_CONSECUTIVE_FAILURES=3

# --- profitability thresholds -------------------------------------------
MIN_PROFIT_USD=5
MIN_PROFIT_BPS=10
SLIPPAGE_BPS=50
MAX_TRADE_USD=50000

# --- flashloan providers (Phase 4) --------------------------------------
ENABLE_BALANCER=true
ENABLE_MORPHO=true
ENABLE_AAVE=true

# --- secrets -------------------------------------------------------------
# NEVER commit a real key. Leave blank until Phase 6 testnet.
# PRIVATE_KEY=0x...
LOG_LEVEL=info