{
  "name": "base-arb-bot",
  "version": "0.1.0",
  "description": "DEX-DEX arbitrage scanner and flashloan executor for Base",
  "scripts": {
    "discover": "tsx src/discovery/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-prices": "tsx src/monitor/validate-prices.ts",
    "monitor": "tsx src/monitor/cli.ts",
    "scan": "tsx src/arb/cli.ts",
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test",
    "build:abi": "cd contracts && forge inspect --json src/FlashloanExecutor.sol:FlashloanExecutor abi > abi/FlashloanExecutor.json"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "private": true,
  "type": "module"
}
